{% macro join_list(value,seps) %}
{%- set ns = namespace(parts=[]) -%}
{%- for item in value -%}
{%-   if item is iterable and item is not string and seps | length > 1 -%}
{%-     set ns.parts = ns.parts + [ item | map('string') | join(seps[1]) ] -%}
{%-   else -%}
{%-     set ns.parts = ns.parts + [ item | string ] -%}
{%-   endif -%}
{%- endfor -%}
{{- ns.parts | join(seps[0]) -}}
{% endmacro %}
{#  An empty list member (none, "" or []) discards everything accumulated
    before it in the list; rendering starts over with the members after it. #}
{% macro render_option(key,value,indent=false,seps=none) %}
{%   if value is defined and value is not none %}
{%     if value is sameas true %}
{%       if indent %}  {% endif %}
{{ key }} yes
{%     elif value is sameas false %}
{%       if indent %}  {% endif %}
{{ key }} no
{%     elif value is string or value is number %}
{%       if indent %}  {% endif %}
{{ key }} {{ value | string }}
{%     else %}
{%       set acc = namespace(items=[]) %}
{%       for i in value %}
{%         if i is none or i == '' or (i is not string and i is iterable and i | length == 0) %}
{%           set acc.items = [] %}
{%         else %}
{%           set acc.items = acc.items + [ i ] %}
{%         endif %}
{%       endfor %}
{%       if seps is not none %}
{%         if acc.items | length > 0 %}
{%           if indent %}  {% endif %}
{{ key }} {{ join_list(acc.items, seps) }}
{%         endif %}
{%       else %}
{%         for i in acc.items %}
{%           if indent %}  {% endif %}
{{ key }} {{ i | string }}
{%         endfor %}
{%       endif %}
{%     endif %}
{%   else %}
{{- '' -}}
{%   endif %}
{% endmacro %}
{% macro body_option(key,override,seps=none) %}
{%   if override is defined %}
{{     render_option(key, override, seps=seps) -}}
{%   elif __sshd_config[key] is defined %}
{{     render_option(key, __sshd_config[key], seps=seps) -}}
{%   elif sshd_main_config_file is not none
        and sshd_config_file | dirname == sshd_main_config_file ~ '.d' %}
{#     Do not use the defaults from main file to avoid recursion #}
{{- '' -}}
{%   elif __sshd_defaults[key] is defined and not sshd_skip_defaults %}
{%     if key == 'HostKey' and __sshd_fips_mode %}
{{       render_option(key, __sshd_defaults[key] | difference(__sshd_hostkeys_nofips), seps=seps) -}}
{%     else %}
{{       render_option(key, __sshd_defaults[key], seps=seps) -}}
{%     endif %}
{%   else %}
{{- '' -}}
{%   endif %}
{% endmacro %}
{% macro match_block(match_list) %}
{%   if match_list["Condition"] is defined %}
{%     set match_list = [ match_list ]%}
{%   endif %}
{%   if match_list is iterable %}
{%     for match in match_list %}
Match {{ match["Condition"] }}
