#!/usr/bin/python3
"""Generate templates/sshd_config.j2 and sshd_config_snippet.j2 from the
fragment files in this directory.

options_match / options_body: one option per line, optionally followed by a
"kind" saying how a list value is rendered:

    Ciphers                      (kind from DEFAULT_KINDS, else default)
    AuthenticationMethods space/comma
    HostKey lines

Kind syntax: separators from outermost to innermost, joined with "/":
    comma          -> one line, items joined by ","
    space          -> one line, items joined by " "
    space/comma    -> list of lists; outer joined by " ", inner by ","
    lines | (none) -> keyword repeated once per list item (old behaviour)
"""
import argparse
import difflib
import json
import sys
from pathlib import Path

SEPARATORS = {"comma": ",", "space": " ", "colon": ":"}

# Kinds applied when the options file gives none. An explicit second column
# in options_match / options_body always wins.
DEFAULT_KINDS = {
    # comma separated
    "Ciphers": "comma",
    "MACs": "comma",
    "KexAlgorithms": "comma",
    "HostKeyAlgorithms": "comma",
    "HostbasedAcceptedAlgorithms": "comma",
    "PubkeyAcceptedAlgorithms": "comma",
    "PubkeyAcceptedKeyTypes": "comma",
    "HostbasedAcceptedKeyTypes": "comma",
    "CASignatureAlgorithms": "comma",
    "GSSAPIKexAlgorithms": "comma",
    "LogVerbose": "comma",
    # space separated
    "AllowUsers": "space",
    "DenyUsers": "space",
    "AllowGroups": "space",
    "DenyGroups": "space",
    "AuthorizedKeysFile": "space",
    "PermitOpen": "space",
    "PermitListen": "space",
    "SetEnv": "space",
    "ChannelTimeout": "space",
    "PubkeyAuthOptions": "space",
    "PerSourcePenalties": "space",
    # space separated list of comma separated lists
    "AuthenticationMethods": "space/comma",
}


def parse_kind(spec):
    """Return a list of separators (outermost first) or None for 'lines'."""
    if spec in ("", "default", "lines", "scalar"):
        return None
    try:
        return [SEPARATORS[tok] for tok in spec.split("/")]
    except KeyError as exc:
        raise ValueError(f"unknown separator {exc} in kind {spec!r}") from None


def read_options(path):
    for lineno, line in enumerate(path.read_text().splitlines(), 1):
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        fields = line.split()
        name = fields[0]
        spec = fields[1] if len(fields) > 1 else DEFAULT_KINDS.get(name, "")
        try:
            yield name, parse_kind(spec)
        except ValueError as exc:
            sys.exit(f"{path}:{lineno}: {exc}")


def seps_arg(seps):
    return "" if seps is None else ",seps=" + json.dumps(seps)


def match_lines(options):
    return "".join(
        '{{       render_option("%s",match["%s"],true%s) -}}\n'
        % (name, name, seps_arg(seps))
        for name, seps in options
    )


def body_lines(options):
    return "".join(
        '{{ body_option("%s",sshd_%s%s) -}}\n' % (name, name, seps_arg(seps))
        for name, seps in options
    )


def generate(src):
    """Return {file name: content} of the templates built from src."""

    def frag(name):
        return (src / name).read_text()

    match = match_lines(read_options(src / "options_match"))
    body = body_lines(read_options(src / "options_body"))
    top = frag("10_top.j2")

    full = (frag("01_ansible_head.j2") + top + match
            + frag("20_middle.j2") + body + frag("30_bottom.j2"))
    snippet = (top.replace("indent=false", "indent=true") + match
               + frag("20_middle.j2") + body + frag("30_bottom.j2"))
    return {"sshd_config.j2": full, "sshd_config_snippet.j2": snippet}


def check(outdir, generated):
    """Print a diff for every template that is not up to date; return ok."""
    ok = True
    for name, text in generated.items():
        path = outdir / name
        current = path.read_text() if path.exists() else ""
        if current == text:
            continue
        ok = False
        sys.stdout.writelines(difflib.unified_diff(
            current.splitlines(keepends=True), text.splitlines(keepends=True),
            fromfile=f"{path} (checked in)", tofile=f"{path} (generated)"))
    if not ok:
        print("\nThe generated templates are out of date. Run\n"
              "    meta/make_option_lists\n"
              "and commit the result.", file=sys.stderr)
    return ok


def main():
    here = Path(__file__).resolve().parent
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--srcdir", type=Path, default=here)
    ap.add_argument("--outdir", type=Path, default=here.parent / "templates")
    ap.add_argument("--check", action="store_true",
                    help="write nothing; show a diff and exit 1 if the "
                         "templates in outdir differ from the generated ones")
    args = ap.parse_args()

    generated = generate(args.srcdir)
    if args.check:
        sys.exit(0 if check(args.outdir, generated) else 1)

    args.outdir.mkdir(parents=True, exist_ok=True)
    for name, text in generated.items():
        (args.outdir / name).write_text(text)


if __name__ == "__main__":
    main()
